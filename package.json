{
  "name": "xonecode",
  "version": "0.5.0",
  "description": "Consola CLI y harness de agente para desarrollar aplicaciones XOne",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "bin": {
    "xonecode": "./dist/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "apps/web/dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js && npm run build:web",
    "build:web": "npm run build --workspace apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "xonecode": "tsx src/bin.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.2",
    "@langchain/core": "1.2.9",
    "@langchain/google-genai": "2.3.0",
    "@langchain/langgraph": "1.4.10",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.5.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "deepagents": "1.13.2",
    "fflate": "^0.8.2",
    "ink": "^5.2.1",
    "ink-testing-library": "^4.0.0",
    "langchain": "1.5.10",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "4.5.4"
  }
}
