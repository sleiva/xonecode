node_modules/
dist/
.worktrees/
# Configuración y CREDENCIALES locales. `auth.json` va con modo 0600 en el HOME del
# usuario, nunca en un proyecto — pero si alguien crea un `.xonecode/` aquí, no se sube.
.xonecode/
# El config de una CLI de agente en esta máquina —hoy el `[mcp_servers]` de Codex—: es de
# quien lo escribió y no del repo, igual que `.xonecode/`. (Lo de Claude se ignora en el
# `core.excludesFile` global, que no lo ve quien clone esto.)
.codex/
.env
.env.*
.DS_Store
*.log
.idea/

# Capturas y volcados del navegador de pruebas: no son del proyecto. `.playwright-mcp/` lo
# escribe la herramienta sola; `capturas/` es la pasada de comprobación visual que se hace a
# mano antes de commitear — se mira una vez y se tira, y ningún doc la enlaza.
.playwright-mcp/
capturas/
