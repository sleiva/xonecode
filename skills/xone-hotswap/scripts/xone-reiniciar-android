#!/usr/bin/env node
/**
 * Dejar el host de Android en un estado conocido: matarlo y volver a levantarlo.
 *
 * POR QUÉ EXISTE. El host guarda la última app ejecutada y la reabre al arrancar, así que si
 * esa app se quedó en un diálogo de error —o simplemente colgada— el canal **no contesta** y
 * cualquier comando que mandes muere con «no se pudo hablar con el aparato». Desde fuera eso
 * se lee como «no hay dispositivo», que es el diagnóstico equivocado: el aparato está, el
 * framework está, y lo que hay es una app atascada delante.
 *
 * Es la primera orden que conviene correr al empezar con un aparato, y la que hay que probar
 * antes de concluir que algo no funciona.
 *
 * USO:
 *   xone-reiniciar-android                        deja el host en su pantalla de inicio
 *   xone-reiniciar-android --app MiApp            y además lanza esa app
 *   xone-reiniciar-android --serie emulator-5554  con varios aparatos conectados
 *   xone-reiniciar-android --puerto 8444          puerto LOCAL del túnel (por omisión el del aparato)
 *
 * **No despliega nada**: no sube ficheros ni toca el proyecto. Para eso está
 * `xone-desplegar-android`, que ya hace este reinicio como uno de sus pasos.
 */
import { execFileSync } from "node:child_process";
import { join } from "node:path";
import { canalDeGranja, serieAndroid, rutaDeAdb, dormir, salidaDelCliente, PUERTO_DEL_HOTSWAP, puertoConMotivo, asegurarTunel } from "../lib/dispositivo.mjs";
import { esperarAppEnGranja, lanzarEnGranja, reiniciarCopia } from "../lib/granja.mjs";

const PAQUETE = "com.xone.android.framework";
const ACTIVIDAD = `${PAQUETE}/com.xone.android.hotswap.activities.SetupActivity`;

const args = process.argv.slice(2);
if (args.includes("--help") || args.includes("-h")) {
  console.error(`xone-reiniciar-android — mata el host de XOne y lo vuelve a levantar.

  xone-reiniciar-android                        lo deja en su pantalla de inicio
  xone-reiniciar-android --app MiApp            y además lanza esa app
  xone-reiniciar-android --serie emulator-5554  con varios aparatos conectados
  xone-reiniciar-android --puerto 8444          puerto LOCAL del túnel (por omisión, el del aparato en
                                                Ajustes → Dispositivos; si no, 8443)

Úsalo cuando el canal no conteste: el host reabre la última app ejecutada, y si ésa se quedó
en un error, nada responde aunque el aparato esté perfectamente. No despliega ni sube nada.`);
  process.exit(0);
}

const opcion = (nombre) => {
  const i = args.indexOf(`--${nombre}`);
  return i >= 0 ? args[i + 1] : undefined;
};
/**
 * **Con la GRANJA, reiniciar es `restart` de la copia** (su API), nunca `am force-stop`/`am start`: la granja los
 * prohíbe (su pantalla virtual se rompería). Medido: `restart` destruye la pantalla, la recrea VACÍA y cierra el canal;
 * lo desplegado sigue en la copia, así que `--app` la vuelve a lanzar.
 */
const granja = canalDeGranja();
if (granja !== undefined) {
  process.stderr.write("dispositivo: la copia de la granja de esta sesión\n");
  try {
    console.log("1/2 reiniciando la copia de la granja (restart)");
    await reiniciarCopia(granja);
    const app = opcion("app");
    if (app === undefined) {
      console.log("2/2 copia reiniciada: la pantalla está vacía. Ninguna app cargada.");
      process.exit(0);
    }
    console.log(`2/2 lanzando ${app}`);
    const lanzada = await lanzarEnGranja(granja, app);
    if (lanzada?.result !== true) {
      console.error(`la copia no aceptó lanzar «${app}»: ${String(lanzada?.status || lanzada?.exceptionMessage || "").slice(0, 200)}`);
      process.exit(1);
    }
    const viva = await esperarAppEnGranja(granja);
    if (viva.viva) {
      console.log(`«${app}» viva en «${viva.pantalla.collection}».`);
      process.exit(0);
    }
    console.error(`«${app}» NO está viva: ${viva.motivo}. Si nunca se ha subido en este turno, primero xone-desplegar-android.`);
    process.exit(1);
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  }
}

// `--serie`, el dispositivo elegido en la sesión o un emulador (`../lib/dispositivo.mjs`). Se
// dice por stderr con cuál y por qué: con varios aparatos, callarlo haría adivinar dónde pasó.
const { serie, porque } = serieAndroid(opcion("serie"));
if (serie !== undefined) process.stderr.write(`dispositivo: ${serie} (${porque})\n`);
// El puerto LOCAL es del aparato (Ajustes → Dispositivos): con dos emuladores, un 8443 fijo
// hacía que el segundo túnel le quitara el aparato al primero sin avisar. Dentro sigue en 8443.
const { puerto: PUERTO, porque: porquePuerto } = puertoConMotivo(opcion("puerto"), serie);
if (porquePuerto !== undefined) process.stderr.write(`puerto: ${PUERTO} (${porquePuerto})\n`);
const adb = (...partes) =>
  execFileSync(rutaDeAdb(), [...(serie ? ["-s", serie] : []), ...partes], { encoding: "utf8" });

const cliente = join(import.meta.dirname, "xone-hotswap");
// En `clave=valor`: el cliente ya no recibe JSON. Y por el MISMO puerto que el túnel de abajo.
const mandar = (comando) => {
  const { command, ...resto } = comando;
  const pares = Object.entries(resto).map(([k, v]) =>
    `${k}=${typeof v === "object" && v !== null ? JSON.stringify(v) : String(v)}`,
  );
  // Un rechazo (`result:false`) vuelve como salida y no lanza: el latido de abajo pregunta con `getAllElements`, que
  // sin app contesta «App is not running» y hace salir al cliente con 1 (`salidaDelCliente`).
  return salidaDelCliente(cliente, [command, ...pares], process.env.HOTSWAP_URL ?? `wss://127.0.0.1:${PUERTO}/hotswap`);
};

/**
 * Sin aparato NO se empieza, y se dice el siguiente paso HECHO.
 *
 * Antes el primer `adb forward` moría con «no devices/emulators found», que es cierto y no
 * dice qué hacer: medido, el modelo se ponía a componer el arranque a mano —y `emulator` no
 * está en el PATH—. Es la regla de `porQueNo`: cuando sabemos la salida, se escribe, no se
 * aconseja.
 */
function exigirAparato() {
  let lista = "";
  try {
    lista = execFileSync(rutaDeAdb(), ["devices"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  } catch (error) {
    console.error(`no pude hablar con adb: ${error.message.split("\n")[0]}`);
    process.exit(1);
  }
  const hay = lista
    .split(/\r?\n/)
    .slice(1)
    .some((l) => /\sdevice$/.test(l.trim()));
  if (!hay) {
    console.error("no hay ningún aparato conectado. Arranca el emulador primero:");
    console.error("  xone-arrancar-android");
    process.exit(1);
  }
}

/**
 * Que el framework ESTÉ instalado, antes de esperar a que su servidor conteste. Sin esto, un aparato
 * sin framework solo se descubría al agotar la espera, con un «comprueba que está instalado». La
 * primera palabra, `FRAMEWORK_AUSENTE`, es la que reconoce quien lo lanza para ofrecer instalarlo.
 * Si no se puede mirar (adb se queja), se sigue: el resto del recorrido dirá lo que pase.
 */
function exigirFramework() {
  let lista;
  try {
    lista = execFileSync(rutaDeAdb(), [...(serie ? ["-s", serie] : []), "shell", "pm", "list", "packages", PAQUETE], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    });
  } catch {
    return;
  }
  if (!lista.split(/\r?\n/).some((l) => l.trim() === `package:${PAQUETE}`)) {
    console.error(`FRAMEWORK_AUSENTE: ${PAQUETE} no está instalado en el aparato.`);
    console.error("Hay que instalar el framework de XOne (Ajustes → Dispositivos) y volver a lanzar.");
    process.exit(1);
  }
}

exigirAparato();
exigirFramework();
console.log(`1/3 túnel (127.0.0.1:${PUERTO} → ${PUERTO_DEL_HOTSWAP} del aparato) y parada de ${PAQUETE}`);
// El túnel PRIMERO y sin quitarlo después: hay que reaplicarlo tras cada reconexión del cable,
// así que quitarlo dejaría al siguiente hablando con nadie.
// Antes de ponerlo, que no sea de OTRO aparato (IXCODE-32): quitárselo dejaría al otro hablando con éste.
if (serie !== undefined) asegurarTunel(serie, PUERTO, { poner: false });
adb("forward", `tcp:${PUERTO}`, `tcp:${PUERTO_DEL_HOTSWAP}`);
adb("shell", "am", "force-stop", PAQUETE);

console.log("2/3 levantando el host");
adb("shell", "am", "start", "-n", ACTIVIDAD);

console.log("3/3 esperando a que el canal CONTESTE");
/**
 * Se espera a una respuesta, no a un reloj: el `am start` vuelve cuando Android acepta el
 * intent, no cuando el servidor escucha. Medido — sin esto, el primer comando de después muere
 * con «Received network error or non-101 status code».
 *
 * Y la pregunta es `getAllElements`: contesta tanto si hay app viva como si no (`App is not
 * running`), así que sirve de latido sin exigir que haya nada cargado.
 */
let vivo = false;
for (let intento = 1; intento <= 20 && !vivo; intento++) {
  try {
    mandar({ command: "getAllElements", format: "xone" });
    vivo = true;
  } catch {
    dormir(1);
  }
}
if (!vivo) {
  console.error(`el canal no levantó. Comprueba que ${PAQUETE} está instalado (adb shell pm list packages | grep xone)`);
  console.error(`y que el puerto del aparato es el ${PUERTO_DEL_HOTSWAP} (local ${PUERTO}): si estaba ocupado, el framework coge el siguiente libre y lo dice en su pantalla.`);
  process.exit(1);
}

const app = opcion("app");
if (app === undefined) {
  console.log("host reiniciado y canal listo. Ninguna app cargada.");
} else {
  console.log(`lanzando ${app}`);
  const lanzada = mandar({ command: "launchApplication", appName: app });
  console.log(lanzada);
  if (lanzada.includes('"result":false')) {
    console.error(`el framework rechazó lanzar «${app}»: comprueba el nombre, o súbela antes con xone-desplegar-android.`);
    process.exit(1);
  }
  for (let intento = 1; intento <= 10; intento++) {
    const salida = mandar({ command: "getAllElements", format: "xone" });
    if (!salida.includes("App is not running")) {
      console.log(salida);
      process.exit(0);
    }
    dormir(2);
  }
  console.error(`«${app}» no llegó a contestar el árbol de controles: NO está viva.`);
  console.error("Si nunca se ha subido a este aparato, primero xone-desplegar-android.");
  process.exit(1);
}
