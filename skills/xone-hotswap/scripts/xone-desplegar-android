#!/usr/bin/env node
/**
 * Poner ESTE proyecto en un Android y dejar la app arrancada. La plantilla completa.
 *
 * POR QUÉ EXISTE. «Lanza la app» no es un comando del protocolo hotswap: es una cadena de
 * cinco pasos, y cuatro de ellos no viajan por el canal (el túnel, el ZIP, la subida HTTP y
 * el reinicio). El canal solo hace el quinto. Esta plantilla es esa cadena, en el orden en el
 * que se midió que funciona.
 *
 * USO (desde la raíz del proyecto, que es el `cwd` de tus comandos):
 *   xone-desplegar-android
 *   xone-desplegar-android --captura
 *   xone-desplegar-android --app MiApp --serie emulator-5554
 *
 * EL ORDEN, Y POR QUÉ ES ESE:
 *  1. **El túnel primero.** Sin `adb forward`, `127.0.0.1:8443` no lleva a ninguna parte: el
 *     servidor escucha en el localhost del APARATO. No se quita al terminar — hay que
 *     reaplicarlo tras cada reconexión, así que quitarlo dejaría el siguiente intento hablando
 *     con nadie.
 *  2. **El ZIP**, sin `.xonecode` ni `.git`. No es higiene: el `checkpoint.sqlite` de un
 *     proyecto real pesaba 122 MB él solo, contra 6,7 MB el proyecto entero.
 *  3. **La subida.** Subir NO aplica: el proceso tiene cargado en memoria lo de antes.
 *  4. **El reinicio**, que es lo único que aplica lo subido. Y es `SetupActivity`, **nunca**
 *     `.mainEntry`: medido, `.mainEntry` no levanta el servidor hotswap.
 *  5. **El lanzamiento**, y LUEGO la comprobación: `{"result":true}` de `launchApplication`
 *     significa «aceptado», no «arrancó». Lo que dice si está viva es el árbol de controles,
 *     que tarda unos segundos en contestar algo.
 *
 * LA TRAMPA QUE CUESTA UNA SESIÓN: **sin `bd/gestion.db` la app no arranca** y el verificador
 * estático dice VERDE igual. El `app.xml` declara `<connection connstring="bd/gestion.db"/>` y
 * esa base se genera FUERA (XOne Studio o `xone-db-tools create-db`). Si la app muere con
 * «Error opening database», mira eso antes que nada.
 *
 * LO QUE NECESITA: `adb` en el PATH, y nada más. El ZIP se construye aquí dentro con `zlib`
 * —ni binario externo ni dependencias—, así que esto no depende de que haya un `zip` en el
 * sistema, que en Windows no lo hay.
 */
process.env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
// Y se calla SU aviso, no todos: node grita en cada arranque que la verificación está
// desactivada, y ese grito acaba en la salida del comando —o sea en el contexto del agente—
// invitándole a «arreglar» algo que es deliberado y está acotado a este proceso hijo.
process.removeAllListeners("warning");
process.on("warning", (aviso) => {
  if (!String(aviso.message).includes("NODE_TLS_REJECT_UNAUTHORIZED")) console.warn(aviso);
});

import { execFileSync } from "node:child_process";
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { basename, join, relative, sep } from "node:path";
import { deflateRawSync } from "node:zlib";
import { serieAndroid } from "../lib/dispositivo.mjs";

const PAQUETE = "com.xone.android.framework";
const ACTIVIDAD = `${PAQUETE}/com.xone.android.hotswap.activities.SetupActivity`;
const PUERTO = 8443;

/**
 * Un ZIP en memoria, sin `zip` del sistema y sin dependencias.
 *
 * Se escribió a mano por dos razones, y ninguna es el gusto por reinventar: **en Windows no
 * hay `zip`**, así que llamar al binario dejaba esta plantilla sirviendo en dos sistemas de
 * tres; y una skill instalada en la casa del usuario no tiene `node_modules` donde resolver
 * una librería. Con `zlib`, que viene con node, no hace falta ninguna de las dos cosas.
 *
 * Es el formato mínimo y suficiente: entradas DEFLATE con cabecera local, directorio central y
 * su cola. Sin ZIP64 —un proyecto XOne no llega a 4 GB ni a 65.535 ficheros— y sin atributos de
 * Unix, que el framework no mira.
 */
const TABLA_CRC = (() => {
  const tabla = new Uint32Array(256);
  for (let i = 0; i < 256; i++) {
    let c = i;
    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
    tabla[i] = c >>> 0;
  }
  return tabla;
})();

function crc32(buf) {
  let c = 0xffffffff;
  for (let i = 0; i < buf.length; i++) c = TABLA_CRC[(c ^ buf[i]) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
}

/** Los ficheros del proyecto, en rutas relativas con `/`, saltándose lo que no sube. */
function ficherosDe(raiz, fuera, dentro = raiz, salida = []) {
  for (const entrada of readdirSync(dentro, { withFileTypes: true })) {
    const completa = join(dentro, entrada.name);
    const rel = relative(raiz, completa).split(sep).join("/");
    if (fuera.some((f) => rel === f || rel.startsWith(`${f}/`))) continue;
    // No se sigue un enlace: un symlink a una carpeta de fuera metería el disco entero.
    if (entrada.isSymbolicLink()) continue;
    if (entrada.isDirectory()) ficherosDe(raiz, fuera, completa, salida);
    else if (entrada.isFile()) salida.push(rel);
  }
  return salida;
}

function crearZip(raiz, fuera) {
  const locales = [];
  const central = [];
  let desplazamiento = 0;

  for (const rel of ficherosDe(raiz, fuera)) {
    const datos = readFileSync(join(raiz, rel));
    const comprimido = deflateRawSync(datos);
    const nombre = Buffer.from(rel, "utf8");
    const suma = crc32(datos);

    const local = Buffer.alloc(30);
    local.writeUInt32LE(0x04034b50, 0);
    local.writeUInt16LE(20, 4); // versión mínima
    local.writeUInt16LE(0x0800, 6); // nombres en UTF-8
    local.writeUInt16LE(8, 8); // deflate
    local.writeUInt32LE(suma, 14);
    local.writeUInt32LE(comprimido.length, 18);
    local.writeUInt32LE(datos.length, 22);
    local.writeUInt16LE(nombre.length, 26);
    locales.push(local, nombre, comprimido);

    const entrada = Buffer.alloc(46);
    entrada.writeUInt32LE(0x02014b50, 0);
    entrada.writeUInt16LE(20, 4);
    entrada.writeUInt16LE(20, 6);
    entrada.writeUInt16LE(0x0800, 8);
    entrada.writeUInt16LE(8, 10);
    entrada.writeUInt32LE(suma, 16);
    entrada.writeUInt32LE(comprimido.length, 20);
    entrada.writeUInt32LE(datos.length, 24);
    entrada.writeUInt16LE(nombre.length, 28);
    entrada.writeUInt32LE(desplazamiento, 42);
    central.push(entrada, nombre);

    desplazamiento += local.length + nombre.length + comprimido.length;
  }

  const cuerpoCentral = Buffer.concat(central);
  const cola = Buffer.alloc(22);
  const cuantos = central.length / 2;
  cola.writeUInt32LE(0x06054b50, 0);
  cola.writeUInt16LE(cuantos, 8);
  cola.writeUInt16LE(cuantos, 10);
  cola.writeUInt32LE(cuerpoCentral.length, 12);
  cola.writeUInt32LE(desplazamiento, 16);
  return Buffer.concat([...locales, cuerpoCentral, cola]);
}

const args = process.argv.slice(2);
const opcion = (nombre) => {
  const i = args.indexOf(`--${nombre}`);
  return i >= 0 ? args[i + 1] : undefined;
};

if (args.includes("--help") || args.includes("-h")) {
  // **Tiene que existir**, y esto no es cortesía: sin `--help` esta orden DESPLEGABA, así que
  // un agente que la usa para orientarse lanzaba el proceso entero creyendo que preguntaba —
  // medido, lo repitió 75 veces en un turno. Una opción que no se entiende no puede ejecutar.
  console.error(`xone-desplegar-android — pone ESTE proyecto en un Android y deja la app arrancada.

  xone-desplegar-android                       nombre de app tomado de app.xml
  xone-desplegar-android --app MiApp           nombre explícito
  xone-desplegar-android --serie emulator-5554 con varios aparatos conectados

Hace la cadena entera: túnel adb, ZIP del proyecto (sin .xonecode ni .git), subida, reinicio del
framework y lanzamiento, y COMPRUEBA que la app esté viva pidiendo su árbol de controles.
Necesita \`adb\` en el PATH; el ZIP lo construye él mismo.

Si la app no arranca, lo primero que hay que mirar es si existe bd/gestion.db: la genera XOne
Studio o \`xone-db-tools\`, no esto, y sin ella la app muere aunque el verificador esté en verde.`);
  process.exit(0);
}

// `--serie`, el dispositivo elegido en la sesión o un emulador (`../lib/dispositivo.mjs`). Se
// dice por stderr con cuál y por qué: con varios aparatos, callarlo haría adivinar dónde pasó.
const { serie, porque } = serieAndroid(opcion("serie"));
if (serie !== undefined) process.stderr.write(`dispositivo: ${serie} (${porque})\n`);
const adb = (...partes) =>
  execFileSync("adb", [...(serie ? ["-s", serie] : []), ...partes], { encoding: "utf8" });

/**
 * Igual, pero sin dejar hablar al hijo por stderr.
 *
 * `execFileSync` hereda stderr por omisión, así que un `pm grant` de un permiso que no es de
 * ejecución escupe una traza de Java entera. Con 63 permisos declarados eso son decenas de
 * pantallas de ruido que acaban en el contexto del agente y le hacen creer que algo se rompió.
 */
const adbCallado = (...partes) =>
  execFileSync("adb", [...(serie ? ["-s", serie] : []), ...partes], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });

/**
 * Cómo se llama la app, en tres saltos y con el último declarado.
 *
 * **El `<app>` de un proyecto XOne real NO lleva `name`** — medido sobre cuatro proyectos del
 * usuario: lleva `prefix`, `version`, `debug`… y nada más. Leerlo de ahí fue el primer intento y
 * falla en todos menos en los de juguete. Donde sí está, cuando está, es en `app.ini`
 * (`name=AppDemo`); y varios proyectos reales ni siquiera tienen `app.ini`.
 *
 * Por eso el último salto es **la carpeta**, que es lo que una persona usaría y lo que casa con
 * cómo guarda el framework lo que sube (`app_<nombre en minúsculas>`). Se DICE cuál se usó, para
 * que quien mire la salida pueda corregir con `--app` en vez de descubrirlo por el resultado.
 */
function nombreDeLaApp() {
  const dicho = opcion("app");
  if (dicho !== undefined) return dicho;

  if (existsSync("app.ini")) {
    const m = /^\s*name\s*=\s*(.+?)\s*$/im.exec(readFileSync("app.ini", "latin1"));
    if (m !== null && m[1] !== "") {
      console.log(`    nombre de app.ini: ${m[1]}`);
      return m[1];
    }
  }

  const deLaCarpeta = basename(process.cwd());
  console.log(`    nombre de la carpeta: ${deLaCarpeta} (usa --app si no es ése)`);
  return deLaCarpeta;
}

/**
 * Concede los permisos de ejecución que el host pide, antes de reiniciarlo.
 *
 * **Sin esto la app no arranca y el síntoma engaña.** Medido: tras el reinicio, Android pone
 * encima su `GrantPermissionsActivity` y la app se queda detrás esperando a que alguien toque
 * «Permitir». El canal deja de contestar y el mensaje honesto —«no llegó a contestar el árbol»—
 * manda a mirar la base de datos, que estaba perfectamente. O sea: un diálogo del SISTEMA
 * disfrazado de app rota.
 *
 * Es lo mismo que hace `adb install -g`, y sobre un aparato de PRUEBAS es lo razonable: lo que
 * se está automatizando es pulsar «Permitir» quince veces. Se conceden solo los que el paquete
 * DECLARA —se leen del aparato, no de una lista nuestra que caducaría con la siguiente versión
 * del framework— y los que no son de ejecución fallan uno a uno sin parar nada.
 */
function concederPermisos() {
  let declaradas;
  try {
    const volcado = adb("shell", "dumpsys", "package", PAQUETE);
    const trozo = /requested permissions:([\s\S]*?)(?:install permissions:|runtime permissions:|$)/.exec(volcado);
    declaradas = (trozo?.[1] ?? "").split("\n").map((l) => l.trim().split(":")[0]).filter((l) => l.startsWith("android.permission."));
  } catch {
    console.log("    no se pudo leer qué permisos pide; sigo");
    return;
  }
  /**
   * **El de dibujar sobre otras apps NO se concede con `pm grant`, y sin él el arranque es una
   * carrera contra el foco.**
   *
   * `SYSTEM_ALERT_WINDOW` es un appop, no un permiso de ejecución, así que el bucle de abajo lo
   * intenta y falla en silencio con los demás. Y lo que concede no es cosmético: Android 10 y
   * superiores BLOQUEAN que una app en segundo plano arranque una actividad, y ese permiso es la
   * exención que reconocen. El framework se va a segundo plano con solo apagarse la pantalla, o
   * en cuanto se cierra la app — así que sin esto `launchApplication` contesta
   * «Cannot launch app while the framework is in the background» y el despliegue parece que
   * funcionó sin que arrancara nada. Es buena parte del síntoma que teníamos apuntado como
   * «`result:true` significa aceptado, no arrancó».
   *
   * Idempotente, y su fallo no para nada: en un aparato donde no aplique, se sigue.
   */
  try {
    adbCallado("shell", "appops", "set", PAQUETE, "SYSTEM_ALERT_WINDOW", "allow");
  } catch {
    // Aparato que no lo admite. El despliegue sigue; lo que se pierde es la garantía de foco.
  }
  let dados = 0;
  for (const permiso of declaradas) {
    try {
      adbCallado("shell", "pm", "grant", PAQUETE, permiso);
      dados += 1;
    } catch {
      // Los que no son de ejecución (`INTERNET`, `FOREGROUND_SERVICE`…) no se conceden así y
      // fallan uno a uno. No es un error: es que no había nada que conceder.
    }
  }
  console.log(`    ${dados} permiso(s) concedido(s) de ${declaradas.length} declarado(s)`);
}

/**
 * La excepción de XOne de ESTE arranque, en las cuatro líneas que importan, o nada.
 *
 * Se lee del log y no de la pantalla porque el diálogo enseña el mensaje recortado y sin el
 * fichero ni la línea; el log trae `Source`, `Cause`, `Line number` y `In include file`, que es
 * lo que deja ir directo al sitio. Se piden pocas líneas: lo que se busca está al principio del
 * arranque, y un volcado grande aquí sería ruido en la salida de un comando.
 */
function excepcionDeXOne() {
  let log;
  try {
    /**
     * **Acotado al PROCESO, no a las últimas N líneas del aparato.** Era `-t 600` a secas, y
     * eso no es «lo último de la app»: son 600 líneas de TODO —Chromium, el sistema, lo que
     * haya—, que en este emulador son un par de minutos. La excepción de XOne se salía de esa
     * ventana enseguida, el despliegue no la veía y no contaba nada.
     *
     * Y lo que pasa después es el motivo de arreglarlo: sin el texto, a quien diagnostica solo
     * le queda **fotografiar el diálogo de error** —visto en una sesión real—, que cuesta 3.375
     * tokens y dice exactamente lo mismo que estas seis líneas.
     *
     * Con `--pid`, 600 líneas son 600 líneas DE LA APP. Es como ya leía `xone-log-android`;
     * que dos sitios miraran el mismo log de forma distinta era la razón de que uno lo
     * encontrara y el otro no.
     */
    const pid = adbCallado("shell", "pidof", PAQUETE).trim().split(/\s+/)[0];
    log = pid
      ? adbCallado("logcat", "-d", "--pid", pid, "-t", "600")
      : adbCallado("logcat", "-d", "-t", "600");
  } catch {
    return undefined;
  }
  const filas = log.split("\n");
  const donde = filas.findIndex((l) => l.includes("XOneJavascriptException"));
  if (donde < 0) return undefined;
  // Desde la excepción, lo que viene detrás es su descripción: fuente, causa, línea y fichero.
  const utiles = filas
    .slice(donde, donde + 12)
    .map((l) => l.replace(/^.*?\bSystem\.err:\s?/, "").trim())
    .filter((l) => l !== "" && !l.startsWith("at "));
  return utiles.slice(0, 6).join("\n");
}

const app = nombreDeLaApp();

{
/**
 * Sin aparato NO se empieza, y se dice el siguiente paso HECHO.
 *
 * Antes el primer `adb forward` moría con «no devices/emulators found», que es cierto y no
 * dice qué hacer: medido, el modelo se ponía a componer el arranque a mano —y `emulator` no
 * está en el PATH—. Es la regla de `porQueNo`: cuando sabemos la salida, se escribe, no se
 * aconseja.
 */
function exigirAparato() {
  let lista = "";
  try {
    lista = execFileSync("adb", ["devices"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  } catch (error) {
    console.error(`no pude hablar con adb: ${error.message.split("\n")[0]}`);
    process.exit(1);
  }
  const hay = lista
    .split(/\r?\n/)
    .slice(1)
    .some((l) => /\sdevice$/.test(l.trim()));
  if (!hay) {
    console.error("no hay ningún aparato conectado. Arranca el emulador primero:");
    console.error("  xone-arrancar-android");
    process.exit(1);
  }
}

  exigirAparato();
  console.log(`1/5 túnel: ${PUERTO}`);
  adb("forward", `tcp:${PUERTO}`, `tcp:${PUERTO}`);

  console.log("2/5 empaquetando el proyecto (sin .xonecode ni .git)");
  const cuerpo = crearZip(process.cwd(), [".xonecode", ".git"]);
  console.log(`    ${(cuerpo.length / 1024).toFixed(0)} KB`);

  console.log(`3/5 subiendo a ${app}`);
  const url = `https://127.0.0.1:${PUERTO}/file_upload?file=debug_app_update.zip&appName=${encodeURIComponent(app)}`;
  const respuesta = await fetch(url, {
    method: "POST",
    body: cuerpo,
    headers: { "Content-Type": "application/octet-stream", "Content-Length": String(cuerpo.length) },
  });
  if (!respuesta.ok) {
    console.error(`la subida falló con ${respuesta.status}`);
    process.exit(1);
  }

  console.log("4/5 permisos y reinicio del framework");
  concederPermisos();
  // El buffer se vacía ANTES de reiniciar para que lo que se lea después sea de ESTE arranque
  // y no la excepción del intento anterior — que es la forma más fácil de «arreglar» algo y
  // creerse que sigue roto, o al revés.
  try {
    adbCallado("logcat", "-c");
  } catch {
    // Si no se puede vaciar, se sigue: el diagnóstico será menos preciso, no falso.
  }
  adb("shell", "am", "force-stop", PAQUETE);
  adb("shell", "am", "start", "-n", ACTIVIDAD);

  console.log("5/5 esperando al canal, lanzando y comprobando que está VIVA");
  const cliente = join(import.meta.dirname, "xone-hotswap");
  /**
   * **En `clave=valor`, que es lo único que el cliente entiende.**
   *
   * Esto mandaba `JSON.stringify(comando)` y se rompió ENTERO el día que el cliente dejó de
   * aceptar JSON: el objeto se metía como NOMBRE del comando, el aparato contestaba
   * `Unknown command: {…}` y el despliegue no lanzaba nada. Lanzar la app, pedir el árbol y
   * capturar —las tres cosas que hace este paso— pasaban por aquí, así que se cayeron las
   * tres a la vez, y en silencio: el script reintenta diez veces y acaba diciendo que el
   * canal no levantó, que manda a mirar el puerto y el paquete en vez de al cliente.
   *
   * La conversión es la misma que hace el cliente al revés: cada campo que no es `command`
   * sale como `clave=valor`, y un objeto o un array se serializan porque el tipado del
   * cliente los reconoce por la forma.
   */
  const mandar = (comando) => {
    const { command, ...resto } = comando;
    const pares = Object.entries(resto).map(([k, v]) =>
      `${k}=${typeof v === "object" && v !== null ? JSON.stringify(v) : String(v)}`,
    );
    return execFileSync("node", [cliente, command, ...pares], { encoding: "utf8" }).trim();
  };
  const esperar = (segundos) => execFileSync("sleep", [String(segundos)]);

  /**
   * **El canal no está en pie justo después del reinicio**, y esto se descubrió corriéndolo:
   * el `am start` vuelve en cuanto Android acepta el intent, no cuando el servidor escucha,
   * así que el primer intento moría con «Received network error or non-101 status code».
   * Se espera a que CONTESTE, que es la condición de verdad, en vez de dormir un rato fijo.
   */
  let listo = false;
  for (let intento = 1; intento <= 15 && !listo; intento++) {
    try {
      mandar({ command: "launchApplication", appName: app });
      listo = true;
    } catch {
      esperar(1);
    }
  }
  if (!listo) {
    console.error(`el servidor hotswap no levantó tras el reinicio. Comprueba que ${PAQUETE} está instalado`);
    console.error("y que el puerto es el 8443 (si estaba ocupado, el framework coge el siguiente libre).");
    process.exit(1);
  }

  // El árbol es la comprobación: `result:true` solo dice que el encargo se aceptó. Se
  // reintenta porque la app tarda unos segundos en tener pantalla, y se espera a una
  // CONDICIÓN y no a un número fijo de segundos.
  for (let intento = 1; intento <= 10; intento++) {
    const salida = mandar({ command: "getAllElements", format: "xone" });
    if (!salida.includes("App is not running")) {
      console.log(salida);
      /**
       * **La captura en la MISMA orden, porque lo que se paga es la ida y vuelta.** Medido: un
       * «lanza la app y sácame una captura» costaba 17 llamadas al modelo, y cada una reenvía
       * el historial entero — mientras que lo que devuelve cada comando es pequeño (1,6 KB el
       * árbol, 108 bytes la captura). O sea que el gasto no es lo que se dice, es cuántas veces
       * hay que volver a preguntar. Tres órdenes encadenadas por el modelo son tres viajes;
       * ésta es una.
       */
      /**
       * **El log ANTES que la captura, y por un fallo visto en vivo.**
       *
       * El orden era al revés y producía una foto que engaña: la app contesta el árbol, se
       * cae mientras se pide la captura, y lo que sale fotografiado es la **pantalla del
       * propio servidor hotswap** —«Applications / MyAllXOne / Explore / Delete», con
       * «Awaiting connection…» abajo—. Eso no es la app, y quien lo mire después no tiene
       * forma de saberlo: parece una app en blanco. Ocurrió con un `--captura` real y el
       * usuario lo cazó mirando el artefacto.
       *
       * Cuando XOne ha reventado al cargar, la respuesta entera está en el LOG y la captura
       * solo añade ruido —y 3.375 tokens si alguien se la enseña al revisor visual—. Así que
       * primero se mira el log; si reventó, se cuenta y NO se captura.
       */
      const roto = excepcionDeXOne();
      if (args.includes("--captura") && roto === undefined) {
        try {
          console.log(mandar({ command: "getScreenshot" }));
        } catch {
          console.error("la app arrancó pero la captura falló; el árbol de arriba sí es bueno.");
        }
      } else if (args.includes("--captura")) {
        console.error(
          "NO capturo: XOne reventó al cargar y lo que saldría en la foto es la pantalla del " +
            "host, no tu app. Lo que pasó está en el log de aquí abajo.",
        );
      }
      // **Estar VIVA no es estar BIEN.** Una app que revienta al cargar la configuración se
      // queda con su diálogo de error delante, y el canal contesta igual: el árbol llega, la
      // captura sale, y todo parece haber ido bien. Quien lo cuenta es el log, y no pedirlo
      // aquí obliga a que alguien se acuerde de hacerlo — que es justo lo que no pasa.
      if (roto !== undefined) {
        console.error("");
        console.error("La app ARRANCÓ pero XOne lanzó una excepción al cargar:");
        console.error(roto);
        console.error("");
        console.error("El runtime de XOne es ES5 (Rhino): nada de `let`, `const`, `=>` ni comas");
        console.error("sobrantes, y una `var` no se puede declarar dos veces en la misma función.");
        process.exit(1);
      }
      process.exit(0);
    }
    esperar(2);
  }
  console.error("la app no llegó a contestar el árbol de controles: NO está viva.");
  // **Lo primero, la excepción**, y antes que cualquier consejo: si XOne reventó al cargar, eso
  // es la respuesta entera y todo lo demás sobra. Aquí hace MÁS falta que en la rama de «está
  // viva»: una app que no llega a arrancar no tiene pantalla que mirar ni árbol que pedir, así
  // que sin esto lo único que queda es adivinar.
  const roto = excepcionDeXOne();
  if (roto !== undefined) {
    console.error("");
    console.error("XOne lanzó una excepción al cargar:");
    console.error(roto);
    console.error("");
    console.error("El motor JS de XOne en Android es Rhino: un error de sintaxis en un fichero");
    console.error("incluido para la app ENTERA. Mira el `;` al final de cada sentencia, las comas");
    console.error("sobrantes y las `var` declaradas dos veces en la misma función.");
    process.exit(1);
  }
  // Antes de mandar a mirar la base de datos, se mira QUÉ hay en pantalla: un diálogo del
  // sistema encima es el falso culpable más caro de este bucle.
  try {
    const foco = adb("shell", "dumpsys", "window").split("\n").find((l) => l.includes("mCurrentFocus")) ?? "";
    if (foco.trim() !== "") console.error(`En pantalla ahora: ${foco.trim()}`);
    if (foco.includes("permissioncontroller")) {
      console.error("Hay un diálogo de PERMISOS de Android encima: la app está detrás, esperando.");
      console.error("Vuelve a intentarlo; si insiste, contéstalo en el aparato.");
      process.exit(1);
    }
  } catch {
    // Si no se puede preguntar, se sigue con el consejo de siempre.
  }
  console.error("Lo primero que hay que mirar es si existe bd/gestion.db (la genera XOne Studio, no esto).");
  process.exit(1);
}
