#!/usr/bin/env node
/**
 * El canal de comandos del servidor hotswap, desde la línea de órdenes.
 *
 * POR QUÉ EXISTE ESTE FICHERO. Los comandos del servidor hotswap viajan por un **WebSocket**,
 * y `curl` no habla WebSocket. En Android 5.0.2.2dev el `POST /command` por HTTP contesta
 * **404** (eso es del flavor `playStoreDeveloper`, no del standalone), así que sin un cliente
 * no hay forma de mandar `getAllElements` ni `getScreenshot` desde una shell. Esto es ese
 * cliente, y por eso vive dentro de la skill: la skill dice QUÉ comandos hay, y esto es con
 * qué se mandan.
 *
 * USO
 *   node "$XONECODE_SKILL_XONE_HOTSWAP/scripts/hotswap.mjs" '{"command":"getAllElements","format":"xone"}'
 *   node "$XONECODE_SKILL_XONE_HOTSWAP/scripts/hotswap.mjs" '{"command":"launchApplication","appName":"miapp"}' '{"command":"getScreenshot"}'
 *
 * Los comandos se mandan EN ORDEN y cada uno espera la respuesta del anterior.
 *
 * ANTES DE LLAMARLO (Android): tiene que estar el túnel, o `127.0.0.1:8443` no lleva a
 * ninguna parte —el servidor escucha en el localhost del APARATO—:
 *   adb forward tcp:8443 tcp:8443
 * En iOS no hay túnel: el simulador comparte la pila de red del Mac.
 *
 * VARIABLES
 *   HOTSWAP_URL          el destino. Por omisión `wss://127.0.0.1:8443/hotswap`.
 *   XONECODE_ARTEFACTOS  dónde dejar lo binario (una captura). Si no está, se dice y no se
 *                        guarda: escribirlo en el proyecto sería ensuciar la app del usuario.
 *   HOTSWAP_TOPE_MS      tope de espera de UNA respuesta. Por omisión 40000.
 *
 * LO QUE IMPRIME: una línea JSON por respuesta, en stdout. Una respuesta con un binario
 * dentro NO se imprime: se guarda a fichero y lo que sale es su nombre y su tamaño. Un
 * `getScreenshot` son ~57.000 caracteres de base64, y volcarlos en la salida de un comando
 * es meterlos en el contexto para siempre sin que nadie pueda mirarlos.
 *
 * TRES COSAS MEDIDAS contra el framework real (Android 5.0.2.2dev, 16-09-2026), que son las
 * que hacen que esto funcione y un cliente escrito de memoria no:
 *  - **El WebSocket vive en `/hotswap`**, no en la raíz: `/`, `/ws`, `/websocket` dan 400.
 *  - **El servidor habla PRIMERO**: al abrir manda `{"command":"server_hello","protocol_version":2}`.
 *    Se ESPERA ese saludo antes de mandar nada; no se provoca.
 *  - **La respuesta llega en `status`**, no en un campo `image`, y una captura viene en
 *    **JPEG** (`/9j/…`), no en PNG.
 */
// El certificado del aparato es autofirmado. Esto vale para ESTE proceso hijo y solo para él
// —no para el harness—, que es justo por lo que el cliente de xonecode no puede hacerlo así.
process.env.NODE_TLS_REJECT_UNAUTHORIZED = "0";
// Y se calla SU aviso, no todos: node grita en cada arranque que la verificación está
// desactivada, y ese grito acaba en la salida del comando —o sea en el contexto del agente—
// invitándole a «arreglar» algo que es deliberado y está acotado a este proceso hijo.
process.removeAllListeners("warning");
process.on("warning", (aviso) => {
  if (!String(aviso.message).includes("NODE_TLS_REJECT_UNAUTHORIZED")) console.warn(aviso);
});

import { mkdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const URL_POR_OMISION = "wss://127.0.0.1:8443/hotswap";
const TOPE_MS = Number(process.env.HOTSWAP_TOPE_MS ?? 40_000);
const ARTEFACTOS = process.env.XONECODE_ARTEFACTOS;
/**
 * Dónde va lo que se saca del contexto y NO es para enseñar: el árbol de controles, el log.
 *
 * Es otra carpeta que la de artefactos, y esa separación es la decisión. Todo lo que cae en
 * `XONECODE_ARTEFACTOS` se ANUNCIA —sale como tarjeta en el hilo y en su pestaña—, y medido
 * sobre una sesión real eso eran diez tarjetas de `respuesta-status-*.json` de las que seis
 * no volvía a abrir nadie, ni el agente ni el juez ni la persona. Una captura sí: la última
 * del turno se la lleva el crítico de pantalla. Por eso las imágenes se quedan en artefactos
 * y el texto se muda aquí. El porqué entero está en `core/hotswap.ts` del harness.
 *
 * Sin la variable se cae a la de artefactos, que es lo que había antes: un harness viejo o
 * el terminal siguen guardando, con el ruido de antes pero sin perder el volcado.
 */
const HOTSWAP = process.env.XONECODE_HOTSWAP ?? ARTEFACTOS;
/**
 * La ruta VIRTUAL de esa carpeta, que es la que el agente puede abrir con `read_file`.
 *
 * Se NOMBRA en la salida porque callarla costaba viajes: el script devolvía un nombre pelado
 * y lo único que el agente tenía era la carpeta del DISCO, así que intentaba leerlo por la
 * ruta absoluta de la máquina y por `/.xonecode/sesiones/…` —las dos denegadas— antes de
 * rendirse y abrirlo con `python3` desde la shell. Es la misma regla que `porQueNo`: decir la
 * ruta buena, no que la adivine.
 */
const RUTA_VIRTUAL = process.env.XONECODE_HOTSWAP === undefined ? "/artefactos/" : "/hotswap/";
/**
 * A partir de aquí una respuesta de TEXTO se guarda en vez de imprimirse.
 *
 * No decide si algo es binario —eso lo dice `extensionDe` mirando los bytes—, solo si cabe en
 * la salida de un comando. El árbol de controles de una pantalla llena son varios miles de
 * caracteres y volcarlos enteros en el contexto del agente cuesta más que la pregunta.
 */
const LARGO_PARA_GUARDAR = 2_000;

const pedidos = process.argv.slice(2);
if (pedidos.length === 0 || pedidos.includes("--help") || pedidos.includes("-h")) {
  // El prompt del agente promete que `--help` contesta. Una promesa así, sin cumplir, cuesta
  // un viaje y deja al modelo adivinando argumentos.
  console.error(`xone-hotswap — manda comandos al servidor hotswap de la app (WebSocket).

  xone-hotswap click name=MAP_BT
  xone-hotswap waitForElement name=BTN_OK timeout=5000 -- click name=BTN_OK
  xone-hotswap screen                        en qué pantalla estás (barato)
  xone-hotswap elements                      el árbol de controles (va a $XONECODE_HOTSWAP)
  xone-hotswap shot                          la captura va a $XONECODE_ARTEFACTOS
  xone-hotswap shot name=MAP_ACEPTAR scale=0.5 quality=40     recortada a un control
  xone-hotswap sql MiApp "SELECT * FROM CLIENTES LIMIT 20"

Cada comando es "<nombre> clave=valor ..."; con -- se encadenan varios por la MISMA
conexion, que es lo que hay que hacer (el servidor admite una sola y cierra la anterior).
Los valores se tipan solos: número, true/false y {...}/[...] como JSON.
Con --dry-run se imprime lo que se enviaría, sin conectar.

Antes, en Android, hace falta el túnel: adb forward tcp:8443 tcp:8443
Una respuesta larga no se imprime: una IMAGEN va a $XONECODE_ARTEFACTOS (y sale en el chat),
el TEXTO va a $XONECODE_HOTSWAP y se relee con read_file en /hotswap/<nombre>.
Variables: HOTSWAP_URL (${URL_POR_OMISION}), XONECODE_ARTEFACTOS, XONECODE_HOTSWAP, HOTSWAP_TOPE_MS.
El catálogo entero de comandos está en el SKILL.md de xone-hotswap.`);
  process.exit(pedidos.length === 0 ? 1 : 0);
}

/**
 * De `clave=valor` a los objetos del protocolo, con `--` separando comandos.
 *
 * **POR QUÉ SE FUE EL JSON.** Antes cada comando era un objeto JSON entre comillas
 * (`'{"command":"click","name":"BTN_OK"}'`). Medido sobre cinco comandos típicos, esta
 * sintaxis los escribe en un **38 % menos de caracteres** —un `click` pasa de 37 a 17— y
 * quita el escapado, que es donde un modelo se equivoca y gasta un viaje en volver a
 * intentarlo. No se aceptan las dos: una capa de compatibilidad es deuda desde el primer día,
 * y el JSON solo se escribía dentro de esta misma skill.
 *
 * Los valores se TIPAN solos —número, `true`/`false`, y `{…}`/`[…]` como JSON— porque el
 * protocolo distingue `timeout=5000` de `"5000"` y `where={"ID":"7"}` es un objeto. Lo que no
 * encaje en ninguno se queda como cadena, que es lo que casi todo es.
 */
function valorTipado(bruto) {
  if (bruto === "true") return true;
  if (bruto === "false") return false;
  if (bruto !== "" && !Number.isNaN(Number(bruto))) return Number(bruto);
  if (/^[{[]/.test(bruto)) {
    try {
      return JSON.parse(bruto);
    } catch {
      salir(`«${bruto.slice(0, 60)}» empieza como JSON pero no lo es`);
    }
  }
  return bruto;
}

/**
 * Los ATAJOS, que existen para lo que si no cuesta dos viajes o un base64 a mano.
 *
 * Cada uno es exactamente un comando del protocolo con sus campos ya puestos: no añaden
 * capacidades, quitan la parte que se escribe mal. `shot` es el que más se nota — decodifica
 * el JPEG y lo deja donde el harness lo anuncia.
 */
const ATAJOS = {
  elements: (resto) => ({ command: "getAllElements", format: resto[0] ?? "xone" }),
  screen: () => ({ command: "getCurrentScreen" }),
  shot: (resto) => aplicarPares({ command: "getScreenshot" }, resto),
  tables: (resto) => ({ command: "getDatabaseTableNames", appName: resto[0] }),
  sql: (resto) => ({ command: "runSql", appName: resto[0], sql: resto.slice(1).join(" ") }),
};

function aplicarPares(json, pares) {
  for (const par of pares) {
    const corte = par.indexOf("=");
    if (corte <= 0) salir(`«${par}» no es clave=valor`);
    json[par.slice(0, corte)] = valorTipado(par.slice(corte + 1));
  }
  return json;
}

/**
 * `--dry-run`: imprime lo que se enviaría y no conecta.
 *
 * No es comodidad: es lo que hace comprobable el tipado de los valores sin un aparato
 * delante —`timeout=5000` tiene que salir como número y `where={...}` como objeto, y si salen
 * como cadena el servidor los rechaza sin decir por qué—. También deja probar un comando
 * escrito a mano antes de gastarle un viaje al canal.
 */
const seco = pedidos.includes("--dry-run");
const utiles = pedidos.filter((a) => a !== "--dry-run");

const comandos = [];
for (const trozo of partirPorSeparador(utiles)) {
  const [cabeza, ...resto] = trozo;
  const atajo = ATAJOS[cabeza];
  comandos.push(atajo ? atajo(resto) : aplicarPares({ command: cabeza }, resto));
}

if (seco) {
  for (const c of comandos) console.log(JSON.stringify(c));
  process.exit(0);
}

/** Parte `a x=1 -- b y=2` en `[["a","x=1"],["b","y=2"]]`. Un `--` suelto no abre comando. */
function partirPorSeparador(args) {
  const trozos = [[]];
  for (const a of args) {
    if (a === "--") trozos.push([]);
    else trozos[trozos.length - 1].push(a);
  }
  return trozos.filter((t) => t.length > 0);
}


function salir(motivo) {
  console.error(`hotswap: ${motivo}`);
  process.exit(1);
}

/**
 * Qué es esto, por sus primeros bytes en base64 — nunca por el nombre del comando.
 *
 * **`undefined` significa «no es una imagen», y eso NO es «es binario desconocido».** Era el
 * bug: cualquier campo de más de 2.000 caracteres se daba por base64 y se pasaba por
 * `Buffer.from(valor, "base64")`. El árbol de `getAllElements` es JSON de TEXTO, así que en
 * cuanto una pantalla tiene bastantes controles pasaba de ese largo, se «decodificaba»
 * —descartando `{`, `"`, `:` y los espacios, que no son del alfabeto base64— y lo que quedaba
 * en el disco eran unos 3/4 de bytes de basura, con nombre `captura-….bin`. Comprobado contra
 * el aparato: el fichero real empezaba por `9da9 9e30 03ff` y un árbol JSON pasado por ese
 * mismo `Buffer.from` empieza exactamente igual. O sea que el agente perdía la pantalla justo
 * cuando la pantalla tenía algo que contar, y encima creía haber guardado una captura.
 */
function imagenDe(base64) {
  if (base64.startsWith("/9j/")) return "jpg";
  if (base64.startsWith("iVBORw0KGgo")) return "png";
  if (base64.startsWith("UklGR")) return "webp";
  return undefined;
}

/**
 * Guarda lo binario y lo sustituye por lo que se puede decir de ello.
 *
 * Mira TODOS los campos de la respuesta, no solo `status`: el campo donde viene el binario
 * ha cambiado entre versiones, y un cliente que solo mire uno se calla justo cuando el
 * servidor cambia de sitio.
 */
function sinBinarios(respuesta) {
  const copia = { ...respuesta };
  for (const [clave, valor] of Object.entries(copia)) {
    if (typeof valor !== "string" || valor.length < LARGO_PARA_GUARDAR) continue;
    const imagen = imagenDe(valor);
    // Una imagen es para MIRARLA y va a artefactos; lo demás es andamio y va a hotswap.
    const destino = imagen === undefined ? HOTSWAP : ARTEFACTOS;
    if (destino === undefined) {
      // Se nombra la variable que FALTA, no siempre la misma: mandar a poner
      // `XONECODE_ARTEFACTOS` cuando lo que falta es la otra es el error que cuesta un viaje.
      const cual = imagen === undefined ? "XONECODE_HOTSWAP ni XONECODE_ARTEFACTOS" : "XONECODE_ARTEFACTOS";
      copia[clave] =
        imagen === undefined
          ? `<${valor.length} caracteres; sin ${cual} no hay dónde guardarlos>`
          : `<imagen ${imagen} de ${valor.length} car.; sin ${cual} no hay dónde guardarla>`;
      continue;
    }
    /**
     * Una imagen se DECODIFICA y se llama captura; lo demás es TEXTO y se guarda tal cual,
     * con su extensión y con un nombre que dice lo que es. Llamar `captura-` a un árbol de
     * controles no era solo feo: mandaba a quien lo leyera a buscar una foto.
     */
    const nombre =
      imagen === undefined
        ? `respuesta-${clave}-${Date.now()}.${valor.trimStart().startsWith("[") || valor.trimStart().startsWith("{") ? "json" : "txt"}`
        : `captura-${Date.now()}.${imagen}`;
    const bytes = imagen === undefined ? Buffer.from(valor, "utf8") : Buffer.from(valor, "base64");
    mkdirSync(destino, { recursive: true });
    writeFileSync(join(destino, nombre), bytes);
    // Con la ruta VIRTUAL delante, que es la que se puede volver a abrir. Una captura sigue
    // diciendo `/artefactos/`, que es donde está y donde la tarjeta del hilo la enseña.
    const virtual = imagen === undefined ? RUTA_VIRTUAL : "/artefactos/";
    copia[clave] = `<guardado como ${virtual}${nombre}, ${bytes.length} bytes>`;
  }
  return copia;
}

const ws = new WebSocket(process.env.HOTSWAP_URL ?? URL_POR_OMISION);
let saludado = false;
let pendiente;
let reloj;

const rearmar = () => {
  clearTimeout(reloj);
  reloj = setTimeout(() => salir(`sin respuesta en ${TOPE_MS} ms`), TOPE_MS);
};

function siguiente() {
  const comando = comandos.shift();
  if (comando === undefined) {
    clearTimeout(reloj);
    ws.close();
    process.exit(0);
  }
  pendiente = comando;
  rearmar();
  ws.send(JSON.stringify(comando));
}

rearmar();
ws.onerror = (e) => salir(`no se pudo hablar con el aparato: ${e.message ?? e}`);
ws.onclose = (e) => {
  if (pendiente !== undefined || comandos.length > 0) {
    salir(`el canal se cerró antes de terminar (${e.code} ${e.reason || "sin motivo"})`);
  }
};
ws.onmessage = (ev) => {
  const texto = typeof ev.data === "string" ? ev.data : Buffer.from(ev.data).toString();
  let mensaje;
  try {
    mensaje = JSON.parse(texto);
  } catch {
    console.error(`hotswap: mensaje que no es JSON: ${texto.slice(0, 200)}`);
    return;
  }
  // El servidor saluda primero y ese saludo no es la respuesta de nadie.
  if (!saludado && mensaje.command === "server_hello") {
    saludado = true;
    siguiente();
    return;
  }
  console.log(JSON.stringify({ comando: pendiente?.command, ...sinBinarios(mensaje) }));
  pendiente = undefined;
  siguiente();
};
