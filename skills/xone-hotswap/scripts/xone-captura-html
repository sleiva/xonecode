#!/usr/bin/env node
/**
 * Una captura PNG de un HTML de la carpeta de artefactos (un diagrama, un informe), para VER cómo
 * se pinta. La regla vive en `../lib/capturaHtml.mjs`.
 *
 * POR QUÉ EXISTE. Medido: el agente compuso a mano un `chrome --headless --screenshot` con su
 * propio `--user-data-dir`, y con un perfil nuevo este Chrome escribe la captura y NO TERMINA: el
 * turno se quedó colgado hasta el tope de la shell. Aquí no se espera a que Chrome salga: se
 * espera al fichero y se le mata.
 *
 * LO QUE NO HACE: no imprime la imagen (cientos de miles de caracteres en base64 que nadie puede
 * mirar ahí). Sale el NOMBRE y la ruta virtual, que es con lo que la interfaz la enseña y el
 * revisor visual la lee.
 *
 * USO:
 *   xone-captura-html /artefactos/diagrama.html              → /artefactos/diagrama.png
 *   xone-captura-html diagrama.html --nombre vista.png
 *   xone-captura-html diagrama.html --ancho 1600 --alto 1200
 */
import { existsSync } from "node:fs";
import { basename, isAbsolute, join, resolve } from "node:path";
import { capturarHtml } from "../lib/capturaHtml.mjs";

const args = process.argv.slice(2);
if (args.length === 0 || args.includes("--help") || args.includes("-h")) {
  console.error(`xone-captura-html — captura un HTML de artefactos a PNG, con Chrome, sin quedarse colgado.

  xone-captura-html /artefactos/diagrama.html          deja /artefactos/diagrama.png
  xone-captura-html diagrama.html --nombre vista.png   con nombre propio
  xone-captura-html diagrama.html --ancho 1600 --alto 1200

El HTML se busca en $XONECODE_ARTEFACTOS (vale la ruta virtual /artefactos/… o el nombre a
secas). No lances Chrome a mano: con un perfil nuevo escribe la captura y no termina.

La captura es de la VENTANA (1400×1000 por omisión), no de la página entera: si el HTML es más
alto y lo quieres completo, sube --alto (hasta 4000). No hace falta medir la página con otro
script: pasarse deja fondo vacío abajo, que el revisor visual cobra por píxel, así que no te
pases de largo.`);
  process.exit(args.length === 0 ? 1 : 0);
}

const ARTEFACTOS = process.env.XONECODE_ARTEFACTOS;
if (ARTEFACTOS === undefined) {
  console.error("no hay XONECODE_ARTEFACTOS: esta sesión no tiene carpeta de artefactos y la captura no se puede guardar.");
  process.exit(1);
}

const opcion = (nombre) => {
  const i = args.indexOf(`--${nombre}`);
  return i >= 0 ? args[i + 1] : undefined;
};
const conValor = new Set(["--nombre", "--ancho", "--alto"]);
const posicional = args.find((a, i) => !a.startsWith("--") && !conValor.has(args[i - 1] ?? ""));

// La ruta VIRTUAL es la que ve el agente en sus tools de fichero; aquí se traduce al disco. Y el
// nombre a secas se busca en artefactos, que es donde viven los HTML que se enseñan.
const html = posicional.startsWith("/artefactos/")
  ? join(ARTEFACTOS, posicional.slice("/artefactos/".length))
  : isAbsolute(posicional)
    ? posicional
    : existsSync(join(ARTEFACTOS, posicional))
      ? join(ARTEFACTOS, posicional)
      : resolve(posicional);

const numero = (nombre, porOmision) => {
  const v = Number(opcion(nombre));
  return Number.isInteger(v) && v >= 200 && v <= 4000 ? v : porOmision;
};

// `basename`: el nombre lo elige el modelo, y un `../` escribiría fuera de la carpeta de la sesión.
const pedido = opcion("nombre");
const conPng = (n) => (/\.png$/i.test(n) ? n : `${n.replace(/\.[A-Za-z0-9]{2,5}$/, "")}.png`);
const nombre = conPng(basename(pedido ?? basename(html)));
if (nombre === ".png" || nombre === "") {
  console.error("ese nombre no vale para un fichero.");
  process.exit(1);
}
const png = join(ARTEFACTOS, nombre);

const r = await capturarHtml({ html, png, ancho: numero("ancho", 1400), alto: numero("alto", 1000) });
if (r.error !== undefined) {
  console.error(`no se pudo capturar: ${r.error}`);
  process.exit(1);
}
console.log(`captura guardada como ${nombre} (${r.bytes} bytes) · /artefactos/${nombre}`);
